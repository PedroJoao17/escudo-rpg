{
  "name": "escudo-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @escudo/api\" \"npm run dev -w @escudo/web\"",
    "dev:demo": "cross-env DEMO_MODE=true npm run dev",
    "build": "npm run build -w @escudo/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "cross-env TEST_MYSQL=true vitest run apps/api/test/mysql.test.js",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @escudo/api",
    "db:seed": "npm run db:seed -w @escudo/api",
    "campaign:import": "node scripts/import-notes.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "vitest": "^5.0.3"
  }
}
